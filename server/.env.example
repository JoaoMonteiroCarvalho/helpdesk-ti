# Copie este arquivo para .env e preencha com os valores reais.
#   cp .env.example .env        (Linux/Mac)
#   Copy-Item .env.example .env (PowerShell)
#
# O .env NUNCA deve ser enviado para o Git: ele contem senhas.

# Porta em que a API vai escutar
PORT=3000

# Conexao com o MySQL
DB_HOST=localhost
DB_PORT=3306
DB_USER=seu_usuario_mysql
DB_PASSWORD=sua_senha_mysql
DB_NAME=helpdesk_ti

# Chave usada para assinar os tokens JWT.
# Gere uma string longa e aleatoria, por exemplo com:
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=troque-por-uma-string-longa-e-aleatoria

# Validade do token: 1d = 1 dia, 2h = 2 horas, 30m = 30 minutos
JWT_EXPIRES_IN=1d

# URL do frontend em producao, usada para restringir o CORS.
# Deixe vazio/comentado em desenvolvimento local.
# CORS_ORIGIN=https://seu-frontend.vercel.app
